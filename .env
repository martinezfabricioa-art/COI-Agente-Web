# API Key de Anthropic (requerida)
ANTHROPIC_API_KEY=tu_api_key_aqui

# Puerto del servidor (default: 8000)
PORT=8000

# Entorno: development | production
ENVIRONMENT=development

# Base de datos (SQLite local por defecto; usar PostgreSQL en prod)
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db

# Orígenes permitidos para CORS (* = todos; o lista separada por comas)
# Ejemplo prod: https://www.centrodelavisionnqn.com.ar,https://centrodelavisionnqn.com.ar
ALLOWED_ORIGINS=*
